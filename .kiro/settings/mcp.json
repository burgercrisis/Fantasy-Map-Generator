{
  "mcpServers": {
    "hub-dev": {
      "command": "node",
      "args": ["${MCP_HUB_SERVER_PATH}"],
      "disabled": false,
      "env": {
        "MCP_HUB_ADMIN_TOKEN": "dev-only",
        "MCP_HUB_PROJECT_ROOTS": "${MCP_HUB_PROJECT_ROOTS}",
        "MCP_HUB_GIT_ROOTS": "${MCP_HUB_GIT_ROOTS}",
        "MCP_HUB_GIT_WRITE_ENABLE": "0",
        "MCP_HUB_PERF_ENABLE": "1",
        "MCP_HUB_PNPM_CMD": "${MCP_HUB_PNPM_CMD}",
        "MCP_HUB_UPSTREAM_CONNECT_DIAGNOSTICS": "1",
        "MCP_HUB_UPSTREAM_URL_ALLOWLIST": "mcp.deepwiki.com;http://127.0.0.1:8000;http://127.0.0.1:8001",
        "MCP_HUB_VERIFY_ROOTS": "${MCP_HUB_VERIFY_ROOTS}",
        "PUPPETEER_BROWSER_EXE": "${PUPPETEER_BROWSER_EXE}"
      },
      "autoApprove": [
        "workstream_list",
        "workstream_create", 
        "lock_acquire",
        "time_now",
        "hub_readme",
        "perf_status"
      ]
    }
  }
}