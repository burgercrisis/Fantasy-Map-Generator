{
  "name": "fantasy-map-generator",
  "private": true,
  "scripts": {
    "mixer:apply-deltas": "pnpm run mixer:guardrails && node tools/mixer-core/apply-mixer-deltas.js",
    "mixer:check-deltas": "pnpm run mixer:guardrails && node tools/mixer-core/apply-mixer-deltas.js --check",
    "mixer:guardrails": "node tools/mixer-core/check-language-mixer-guardrails.js",
    "generate:language-mixer": "node tools/mixer-core/generate-language-mixer.js",
    "diff:families": "node tools/mixer-core/diff-language-families.js",
    "mixer:check-and-generate": "node tools/mixer-core/diff-language-families.js && node tools/mixer-core/generate-language-mixer.js",
    "mixer:coverage": "node tools/mixer-core/check-language-mixer-coverage.js",
    "mixer:lexifier-auto": "node tools/mixer-catalog/add-lexifier.js",
    "mixer:qa": "node tools/mixer-core/diff-language-families.js && node tools/mixer-core/check-language-mixer-coverage.js",
    "mixer:full": "node tools/mixer-catalog/add-lexifier.js && node tools/mixer-core/diff-language-families.js && node tools/mixer-core/generate-language-mixer.js",
    "mixer:namedups": "node tools/mixer-diagnostics/check-language-mixer-name-duplicates.js",
    "mixer:failures": "node tools/mixer-core/check-language-mixer-failures.js",
    "mixer:health": "node tools/mixer-core/run-language-mixer-health.js",
    "mixer:doctor": "node tools/mixer-core/mixer-doctor.js",
    "mixer:integration-table": "node tools/mixer-core/generate-language-integration-table.js",
    "mixer:race-coverage": "node tools/mixer-races/report-race-language-coverage.js",
    "mixer:race-per-coverage": "node tools/mixer-races/report-per-race-language-coverage.js",
    "mixer:race-suite": "node tools/mixer-races/run-race-language-suite.js",
    "mixer:clean-map": "node tools/mixer-diagnostics/clean-language-mixer-map.js",
    "namebases:lengths": "node tools/mixer-namebases/check-namebase-lengths.js"
  }
}
